{
  "openapi": "3.0.4",
  "info": {
    "title": "Client Parameter Styles",
    "version": "1.0.0",
    "description": "Covers the parameter shapes whose wire encoding the client has to get right: array queries, a cookie parameter, and values fmt.Sprint would mangle."
  },
  "paths": {
    "/search/{groupId}": {
      "get": {
        "operationId": "Search",
        "parameters": [
          {
            "name": "groupId",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          },
          {
            "name": "tags",
            "in": "query",
            "required": false,
            "schema": {
              "type": "array",
              "items": { "type": "string" }
            }
          },
          {
            "name": "ids",
            "in": "query",
            "required": false,
            "schema": {
              "type": "array",
              "items": { "type": "integer", "format": "int64" }
            }
          },
          {
            "name": "exact",
            "in": "query",
            "required": false,
            "schema": { "type": "boolean" }
          },
          {
            "name": "score",
            "in": "query",
            "required": false,
            "schema": { "type": "number" }
          },
          {
            "name": "since",
            "in": "query",
            "required": false,
            "schema": { "type": "string", "format": "date-time" }
          },
          {
            "name": "day",
            "in": "query",
            "required": false,
            "schema": { "type": "string", "format": "date" }
          },
          {
            "name": "session",
            "in": "cookie",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Matches",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "total": { "type": "integer", "format": "int64" }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {}
  }
}
