{
  "components": {
    "schemas": {
      "CompanyDetailResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "description": "Company unique identifier."
          },
          "name": {
            "type": "string",
            "nullable": true,
            "description": "Registered corporate name."
          },
          "jurisdictionCountryCode": {
            "type": "string",
            "nullable": true,
            "minLength": 2,
            "maxLength": 2,
            "description": "Country of incorporation (ISO 3166-1 alpha-2)."
          },
          "registrationNumber": {
            "type": "string",
            "nullable": true,
            "description": "Official company registration number."
          },
          "taxId": {
            "type": "string",
            "nullable": true,
            "description": "VAT, LEI, or national tax identifier."
          },
          "email": {
            "type": "string",
            "nullable": true,
            "format": "email",
            "description": "Company contact email."
          },
          "phone": {
            "type": "string",
            "nullable": true,
            "description": "Company contact phone number."
          },
          "website": {
            "type": "string",
            "nullable": true,
            "format": "uri",
            "description": "Public company website."
          },
          "kybVerificationLink": {
            "type": "string",
            "maxLength": 1024,
            "format": "uri",
            "description": "External KYB verification link."
          },
          "compliance": {
            "type": "object",
            "nullable": true,
            "description": "Canonical structured compliance values stored for the company.",
            "properties": {
              "sourceOfFunds": {
                "type": "string",
                "enum": [
                  "BUSINESS_TRADING_REVENUE",
                  "SHAREHOLDER_CAPITAL_EQUITY_CONTRIBUTION",
                  "INTRA_GROUP_FINANCING_PARENT_FUNDING",
                  "BANK_LOAN_CREDIT_FACILITY",
                  "INVESTOR_FUNDRAISING_PROCEEDS",
                  "SALE_OF_ASSETS_BUSINESS",
                  "CRYPTO_ASSET_ACTIVITY_PROCEEDS",
                  "THIRD_PARTY_CLIENT_FUNDS",
                  "OTHER"
                ],
                "description": "Source of funds. Allowed values: BUSINESS_TRADING_REVENUE = Business / trading revenue; SHAREHOLDER_CAPITAL_EQUITY_CONTRIBUTION = Shareholder capital / equity contribution; INTRA_GROUP_FINANCING_PARENT_FUNDING = Intra-group financing / parent funding; BANK_LOAN_CREDIT_FACILITY = Bank loan / credit facility; INVESTOR_FUNDRAISING_PROCEEDS = Investor / fundraising proceeds (VC, PE); SALE_OF_ASSETS_BUSINESS = Sale of assets / business; CRYPTO_ASSET_ACTIVITY_PROCEEDS = Proceeds from crypto-asset activity; THIRD_PARTY_CLIENT_FUNDS = Third-party / client funds (not own funds); OTHER = Other (not listed)."
              },
              "sourceOfFundsDetails": {
                "type": "string",
                "description": "Original narrative when sourceOfFunds is OTHER.",
                "maxLength": 1024
              },
              "purpose": {
                "type": "string",
                "enum": [
                  "OPERATIONAL_ACCOUNT",
                  "SALARY",
                  "INVESTMENT",
                  "TREASURY_MANAGEMENT",
                  "ON_OFF_RAMP",
                  "INTERNATIONAL_PAYMENTS",
                  "OTHER"
                ],
                "description": "Purpose of the relationship. Allowed values: OPERATIONAL_ACCOUNT = Operational account; SALARY = Salary; INVESTMENT = Investment; TREASURY_MANAGEMENT = Treasury management; ON_OFF_RAMP = On/Off-ramp (fiat <-> crypto); INTERNATIONAL_PAYMENTS = International payments / remittance; OTHER = Other (not listed - please specify)."
              },
              "purposeDetails": {
                "type": "string",
                "description": "Original narrative when purpose is OTHER.",
                "maxLength": 1024
              },
              "expectedYearlyTxCount": {
                "type": "string",
                "enum": [
                  "LT_50",
                  "B_50_500",
                  "B_500_5000",
                  "B_5000_50000",
                  "GT_50000"
                ],
                "description": "Expected yearly transaction count. Allowed values: LT_50 = < 50 transactions / year; B_50_500 = 50 - 500 transactions / year; B_500_5000 = 500 - 5,000 transactions / year; B_5000_50000 = 5,000 - 50,000 transactions / year; GT_50000 = > 50,000 transactions / year.",
                "example": "B_50_500"
              },
              "geographicScope": {
                "type": "array",
                "description": "Countries accounting for more than 20% of expected flows and their direction.",
                "items": {
                  "type": "object",
                  "required": [
                    "countryCode",
                    "direction"
                  ],
                  "properties": {
                    "countryCode": {
                      "type": "string",
                      "minLength": 2,
                      "maxLength": 2,
                      "example": "FR"
                    },
                    "direction": {
                      "type": "string",
                      "enum": [
                        "SEND",
                        "RECEIVE",
                        "BOTH"
                      ],
                      "description": "SEND = outbound; RECEIVE = inbound; BOTH = inbound and outbound.",
                      "example": "BOTH"
                    }
                  }
                }
              },
              "productsSubscribed": {
                "type": "array",
                "description": "Products selected by the customer.",
                "items": {
                  "type": "string",
                  "enum": [
                    "DIRECT_MINT_BURN",
                    "EUR_ACCOUNT",
                    "FX_SWAP"
                  ]
                },
                "example": [
                  "EUR_ACCOUNT"
                ]
              },
              "financialAssets": {
                "type": "string",
                "enum": [
                  "LT_100K",
                  "B_100K_1M",
                  "B_1M_10M",
                  "B_10M_100M",
                  "GT_100M",
                  "OTHER"
                ],
                "description": "Total financial assets. Allowed values: LT_100K = < €100,000; B_100K_1M = €100,000 - €1,000,000; B_1M_10M = €1,000,000 - €10,000,000; B_10M_100M = €10,000,000 - €100,000,000; GT_100M = > €100,000,000; OTHER = Other."
              },
              "financialAssetsOther": {
                "type": "string",
                "description": "Original narrative when financialAssets is OTHER.",
                "maxLength": 255
              },
              "turnoverBracket": {
                "type": "string",
                "enum": [
                  "LT_100K",
                  "B_100K_1M",
                  "B_1M_10M",
                  "B_10M_50M",
                  "B_50M_250M",
                  "GT_250M",
                  "OTHER"
                ],
                "description": "Annual turnover. Allowed values: LT_100K = < €100,000; B_100K_1M = €100,000 - €1,000,000; B_1M_10M = €1,000,000 - €10,000,000; B_10M_50M = €10,000,000 - €50,000,000; B_50M_250M = €50,000,000 - €250,000,000; GT_250M = > €250,000,000; OTHER = Other."
              },
              "turnoverBracketOther": {
                "type": "string",
                "description": "Original narrative when turnoverBracket is OTHER.",
                "maxLength": 255
              },
              "expectedYearlyVolume": {
                "type": "string",
                "enum": [
                  "LT_100K",
                  "B_100K_1M",
                  "B_1M_10M",
                  "B_10M_50M",
                  "B_50M_250M",
                  "GT_250M"
                ],
                "description": "Expected yearly transaction volume. Allowed values: LT_100K = < €100,000; B_100K_1M = €100,000 - €1,000,000; B_1M_10M = €1,000,000 - €10,000,000; B_10M_50M = €10,000,000 - €50,000,000; B_50M_250M = €50,000,000 - €250,000,000; GT_250M = > €250,000,000."
              },
              "website": {
                "type": "string",
                "format": "uri",
                "example": "https://dupont-fils.fr"
              }
            }
          },
          "brandName": {
            "type": "string",
            "nullable": true,
            "description": "Commercial or trading name."
          },
          "legalForm": {
            "type": "string",
            "nullable": true,
            "enum": [
              "LISTED_PUBLIC_COMPANY",
              "REGULATED_FINANCIAL_INSTITUTION",
              "REGULATED_INVESTMENT_FUND",
              "PRIVATE_LIMITED_COMPANY",
              "PUBLIC_LIMITED_COMPANY",
              "COOPERATIVE_MUTUAL_ENTITY",
              "PARTNERSHIP_CIVIL_COMPANY",
              "FOREIGN_BRANCH",
              "HOLDING_SPV",
              "TRUST_OR_SIMILAR_ARRANGEMENT",
              "FOUNDATION_OR_ENDOWMENT",
              "NON_PROFIT_ASSOCIATION_NGO",
              "GOVERNMENT_PUBLIC_AUTHORITY",
              "STATE_OWNED_ENTERPRISE",
              "OTHER",
              "SOLE_PROPRIETORSHIP"
            ],
            "description": "Legal form; OTHER uses legalFormOther."
          },
          "legalFormOther": {
            "type": "string",
            "nullable": true,
            "description": "Free-text legal form when legalForm is OTHER."
          },
          "registrationDate": {
            "type": "string",
            "nullable": true,
            "format": "date",
            "description": "Date the legal entity was registered."
          },
          "sector": {
            "type": "string",
            "nullable": true,
            "enum": [
              "AGRICULTURE_FORESTRY_FISHING",
              "MINING_QUARRYING_EXTRACTIVES",
              "MANUFACTURING_GENERAL",
              "TEXTILES_CLOTHING_LEATHER_MANUFACTURING",
              "ENERGY_UTILITIES",
              "CONSTRUCTION_PUBLIC_WORKS",
              "WHOLESALE_RETAIL_GENERAL",
              "PRECIOUS_METALS_JEWELLERY_ART_ANTIQUES",
              "MOTOR_VEHICLE_BOAT_LUXURY_GOODS",
              "TRANSPORT_LOGISTICS",
              "POSTAL_COURIER_VALUE_TRANSFER",
              "ACCOMMODATION_FOOD_SERVICE",
              "INFORMATION_IT_COMMUNICATION",
              "FINANCIAL_INSURANCE_SERVICES",
              "MONEY_SERVICES_CURRENCY_EXCHANGE",
              "CRYPTO_ASSET_SERVICES",
              "REAL_ESTATE",
              "LEGAL_ACCOUNTING_AUDIT_ADVISORY",
              "OTHER_PROFESSIONAL_SCIENTIFIC_TECHNICAL",
              "ADMINISTRATIVE_SUPPORT_SERVICES",
              "GAMBLING_BETTING_CASINOS",
              "ARTS_ENTERTAINMENT_RECREATION_OTHER",
              "ARMS_DEFENCE_DUAL_USE_GOODS",
              "PUBLIC_ADMIN_EDUCATION_HEALTH_SOCIAL",
              "PERSONAL_HOUSEHOLD_SERVICES",
              "OTHER"
            ],
            "description": "Business sector; OTHER uses sectorOther."
          },
          "sectorOther": {
            "type": "string",
            "nullable": true,
            "description": "Free-text business sector when sector is OTHER."
          },
          "activityDescription": {
            "type": "string",
            "nullable": true,
            "description": "Description of the company business activity.",
            "maxLength": 1024
          },
          "crsClassification": {
            "type": "string",
            "nullable": true,
            "enum": [
              "ACTIVE_NFE",
              "PASSIVE_NFE",
              "FINANCIAL_INSTITUTION"
            ],
            "description": "Common Reporting Standard classification."
          },
          "taxResidenceCountryCode": {
            "type": "string",
            "nullable": true,
            "description": "Tax-residence country (ISO 3166-1 alpha-2).",
            "minLength": 2,
            "maxLength": 2
          },
          "tin": {
            "type": "string",
            "nullable": true,
            "description": "Tax identification number."
          },
          "preferredBankAccount": {
            "type": "string",
            "nullable": true,
            "description": "Preferred bank account for incoming settlements."
          },
          "preferredWalletChain": {
            "type": "string",
            "nullable": true,
            "enum": [
              "RIPPLE",
              "ETHEREUM",
              "POLYGON",
              "AVALANCHE",
              "PLASMA",
              "SOLANA",
              "P_LAYER"
            ],
            "description": "Preferred wallet network for incoming settlements."
          },
          "preferredWalletAddress": {
            "type": "string",
            "nullable": true,
            "description": "Preferred wallet address on preferredWalletChain."
          },
          "capacity": {
            "type": "string",
            "nullable": true,
            "enum": [
              "OWN_ACCOUNT",
              "THIRD_PARTY_FUNDS"
            ],
            "description": "Whether the company acts for its own account or with third-party funds."
          },
          "physicalAddress": {
            "type": "object",
            "nullable": true,
            "required": [
              "addressLine1",
              "city",
              "zipCode",
              "countryCode"
            ],
            "properties": {
              "addressLine1": {
                "type": "string",
                "description": "Street address line 1",
                "example": "12 Rue de Rivoli"
              },
              "addressLine2": {
                "type": "string",
                "description": "Street address line 2",
                "example": "Bâtiment B"
              },
              "city": {
                "type": "string",
                "description": "City",
                "example": "Paris"
              },
              "zipCode": {
                "type": "string",
                "description": "Postal/ZIP code",
                "example": "75001"
              },
              "countryCode": {
                "type": "string",
                "description": "ISO 3166-1 alpha-2 country code",
                "example": "FR",
                "minLength": 2,
                "maxLength": 2
              }
            },
            "description": "Structured registered physical address."
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "description": "Company creation timestamp."
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "description": "Company update timestamp."
          },
          "legalRepresentatives": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CompanyIndividualResponseDto"
            }
          },
          "ubos": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CompanyUboResponseDto"
            }
          },
          "tcAcceptances": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TcAcceptanceResponseDto"
            }
          },
          "documents": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DocumentResponseDto"
            }
          }
        },
        "required": [
          "id",
          "name",
          "jurisdictionCountryCode",
          "registrationNumber",
          "taxId",
          "email",
          "phone",
          "website",
          "kybVerificationLink",
          "compliance",
          "brandName",
          "legalForm",
          "legalFormOther",
          "registrationDate",
          "sector",
          "sectorOther",
          "activityDescription",
          "crsClassification",
          "taxResidenceCountryCode",
          "tin",
          "preferredBankAccount",
          "preferredWalletChain",
          "preferredWalletAddress",
          "capacity",
          "createdAt",
          "updatedAt",
          "legalRepresentatives",
          "ubos",
          "tcAcceptances",
          "documents"
        ]
      }
    }
  }
}