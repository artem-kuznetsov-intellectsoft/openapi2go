{
  "openapi": "3.0.4",
  "info": {
    "title": "OpenAPI Spec Extended Type-Format Pairs Example",
    "description": "An OpenAPI 3.0 document showing all official type-format pairs alongside other commonly supported string validation formats (UUID, Email, URI).",
    "version": "1.1.0"
  },
  "paths": {
    "/example": {
      "post": {
        "summary": "Example endpoint using all format pairs",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AllSpecFormats"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AllSpecFormats"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AllSpecFormats": {
        "type": "object",
        "description": "A schema displaying all official data type format pairs registered in the OpenAPI Specification 3.0 alongside other widely supported formats.",
        "properties": {
          "integer_int32": {
            "type": "integer",
            "format": "int32",
            "description": "Signed 32-bit integer",
            "example": 2147483647
          },
          "integer_int64": {
            "type": "integer",
            "format": "int64",
            "description": "Signed 64-bit integer",
            "example": 9223372036854775807
          },
          "number_float": {
            "type": "number",
            "format": "float",
            "description": "Single-precision floating-point number",
            "example": 3.14
          },
          "number_double": {
            "type": "number",
            "format": "double",
            "description": "Double-precision floating-point number",
            "example": 3.141592653589793
          },
          "string_byte": {
            "type": "string",
            "format": "byte",
            "description": "Base64-encoded characters representing binary data",
            "example": "U3dhZ2dlciByb2Nrcw=="
          },
          "string_binary": {
            "type": "string",
            "format": "binary",
            "description": "Any sequence of octets representing raw binary data",
            "example": "raw-binary-octets"
          },
          "string_date": {
            "type": "string",
            "format": "date",
            "description": "Full calendar date as defined by RFC3339 full-date",
            "example": "2026-08-12"
          },
          "string_date-time": {
            "type": "string",
            "format": "date-time",
            "description": "Complete date-time string as defined by RFC3339 date-time",
            "example": "2026-08-12T15:52:20Z"
          },
          "string_password": {
            "type": "string",
            "format": "password",
            "description": "A string value suggesting that UI editors mask the input",
            "example": "secret_password_hint"
          },
          "string_uuid": {
            "type": "string",
            "format": "uuid",
            "description": "A universally unique identifier as referenced in spec examples",
            "example": "123e4567-e89b-12d3-a456-426614174000"
          },
          "string_email": {
            "type": "string",
            "format": "email",
            "description": "An email address conforming to RFC5322",
            "example": "developer@example.com"
          },
          "string_uri": {
            "type": "string",
            "format": "uri",
            "description": "A formatted Uniform Resource Identifier according to RFC3986",
            "example": "https://spec.openapis.org/oas/v3.0.4.html"
          }
        },
        "required": [
          "integer_int32",
          "integer_int64",
          "number_float",
          "number_double",
          "string_byte",
          "string_binary",
          "string_date",
          "string_date-time",
          "string_password",
          "string_uuid",
          "string_email",
          "string_uri"
        ]
      }
    }
  }
}