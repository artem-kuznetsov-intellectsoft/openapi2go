{
  "openapi": "3.0.4",
  "info": {
    "title": "OpenAPI-to-Go Generator Test Cases",
    "version": "1.0.0",
    "description": "Exercises the omitzero-mapping.md rule: a non-pointer struct-typed optional field must use ,omitzero instead of ,omitempty, while scalar/enum/map/slice fields and pointer (nullable) fields keep ,omitempty."
  },
  "paths": {},
  "components": {
    "schemas": {
      "Address": {
        "type": "object",
        "properties": {
          "city": {
            "type": "string"
          }
        }
      },
      "OmitZero": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "shippingAddress": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Address"
              }
            ],
            "nullable": true
          },
          "billingAddress": {
            "$ref": "#/components/schemas/Address"
          },
          "customerType": {
            "type": "string",
            "enum": [
              "INDIVIDUAL",
              "COMPANY"
            ]
          },
          "idOrCode": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              }
            ]
          },
          "profile": {
            "type": "object",
            "properties": {
              "bio": {
                "type": "string"
              }
            }
          },
          "metadata": {
            "type": "object"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
