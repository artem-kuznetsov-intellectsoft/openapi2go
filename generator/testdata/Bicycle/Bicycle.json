{
  "openapi": "3.0.4",
  "info": {
    "title": "OpenAPI-to-Go Generator Test Cases",
    "version": "1.0.0",
    "description": "A collection of atomic OpenAPI 3.0 Schema Objects representing different structural variations and data types to thoroughly test a Go struct generator."
  },
  "paths": {},
  "components": {
    "schemas": {
      "Bicycle": {
        "type": "object",
        "required": [
          "vehicle_type",
          "has_basket"
        ],
        "properties": {
          "vehicle_type": {
            "type": "string"
          },
          "has_basket": {
            "type": "boolean"
          },
          "frame_size": {
            "type": "string"
          }
        }
      }
    }
  }
}
