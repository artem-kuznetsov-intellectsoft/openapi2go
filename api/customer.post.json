{
  "paths": {
    "/customer": {
      "post": {
        "description": "Add a legal-entity customer for completion through a prefilled KYB wizard. The customer remains pending and sanctions screening starts only after successful BiometrID verification.",
        "operationId": "CustomerController_createCustomer",
        "parameters": [],
        "requestBody": {
          "required": true,
          "description": "Customer data",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "name",
                  "jurisdictionCountryCode",
                  "physicalAddress",
                  "companyRegistrationNumber",
                  "kybVerificationLink",
                  "legalForm",
                  "registrationDate",
                  "sector",
                  "activityDescription",
                  "crsClassification",
                  "taxResidenceCountryCode"
                ],
                "properties": {
                  "externalId": {
                    "type": "string",
                    "description": "Optional external ID assigned by Superclient",
                    "example": "CUST-12345",
                    "maxLength": 255
                  },
                  "name": {
                    "type": "string",
                    "description": "Customer name",
                    "example": "Dupont & Fils SAS"
                  },
                  "jurisdictionCountryCode": {
                    "type": "string",
                    "description": "ISO 3166-1 alpha-2 country code of jurisdiction",
                    "example": "FR",
                    "minLength": 2,
                    "maxLength": 2
                  },
                  "physicalAddress": {
                    "type": "object",
                    "required": [
                      "addressLine1",
                      "city",
                      "zipCode",
                      "countryCode"
                    ],
                    "properties": {
                      "addressLine1": {
                        "type": "string",
                        "description": "Street address line 1",
                        "example": "12 Rue de Rivoli"
                      },
                      "addressLine2": {
                        "type": "string",
                        "description": "Street address line 2",
                        "example": "Bâtiment B"
                      },
                      "city": {
                        "type": "string",
                        "description": "City",
                        "example": "Paris"
                      },
                      "zipCode": {
                        "type": "string",
                        "description": "Postal/ZIP code",
                        "example": "75001"
                      },
                      "countryCode": {
                        "type": "string",
                        "description": "ISO 3166-1 alpha-2 country code",
                        "example": "FR",
                        "minLength": 2,
                        "maxLength": 2
                      }
                    },
                    "description": "Company physical address"
                  },
                  "companyTaxId": {
                    "type": "string",
                    "description": "VAT / LEI / national tax ID",
                    "example": "FR12345678901"
                  },
                  "companyRegistrationNumber": {
                    "type": "string",
                    "description": "Registration number",
                    "example": "832 456 789"
                  },
                  "email": {
                    "type": "string",
                    "description": "E-mail address",
                    "example": "contact@dupont-fils.fr"
                  },
                  "phone": {
                    "type": "string",
                    "description": "Phone number",
                    "example": "+33145678901"
                  },
                  "website": {
                    "type": "string",
                    "description": "Website URL",
                    "example": "https://dupont-fils.fr"
                  },
                  "kybVerificationLink": {
                    "type": "string",
                    "description": "KYB verification link",
                    "maxLength": 1024,
                    "example": "https://kyb.example.com/verify/dupont-fils"
                  },
                  "brandName": {
                    "type": "string",
                    "description": "Optional. Public brand / trade name if different from legal name.",
                    "example": "Dupont & Fils"
                  },
                  "legalForm": {
                    "type": "string",
                    "description": "Legal form / entity type.",
                    "example": "PRIVATE_LIMITED_COMPANY"
                  },
                  "legalFormOther": {
                    "type": "string",
                    "description": "Required when legalForm = OTHER.",
                    "example": "Société Civile Immobilière"
                  },
                  "registrationDate": {
                    "type": "string",
                    "format": "date",
                    "description": "Company registration date (YYYY-MM-DD).",
                    "example": "2015-06-15"
                  },
                  "sector": {
                    "type": "string",
                    "description": "Business sector.",
                    "example": "INFORMATION_IT_COMMUNICATION"
                  },
                  "sectorOther": {
                    "type": "string",
                    "description": "Required when sector = OTHER.",
                    "example": "Specialty consulting"
                  },
                  "activityDescription": {
                    "type": "string",
                    "description": "Free-text description of the activity.",
                    "maxLength": 1024,
                    "example": "B2B SaaS for compliance teams."
                  },
                  "crsClassification": {
                    "type": "string",
                    "description": "CRS classification.",
                    "example": "ACTIVE_NFE"
                  },
                  "taxResidenceCountryCode": {
                    "type": "string",
                    "description": "Tax residence country (ISO-3166 alpha-2).",
                    "example": "FR",
                    "minLength": 2,
                    "maxLength": 2
                  },
                  "tin": {
                    "type": "string",
                    "description": "Tax Identification Number. Required when taxResidenceCountryCode ≠ FR.",
                    "example": "FR1234567890"
                  },
                  "preferredBankAccount": {
                    "type": "string",
                    "description": "Optional. IBAN of preferred bank account.",
                    "example": "FR7630006000011234567890189"
                  },
                  "preferredWalletChain": {
                    "type": "string",
                    "description": "Optional. Preferred wallet chain.",
                    "example": "ETHEREUM"
                  },
                  "preferredWalletAddress": {
                    "type": "string",
                    "description": "Optional. Preferred wallet address on the selected chain.",
                    "example": "0x000000000000000000000000000000000000dEaD"
                  },
                  "compliance": {
                    "type": "object",
                    "required": [
                      "sourceOfFunds",
                      "purpose",
                      "expectedYearlyTxCount",
                      "geographicScope",
                      "productsSubscribed",
                      "financialAssets",
                      "turnoverBracket"
                    ],
                    "properties": {
                      "sourceOfFunds": {
                        "type": "string",
                        "description": "Source of funds. Free text is accepted, but sending one of these recognised codes keeps the structured value (any other text is stored as OTHER + details). Codes: BUSINESS_TRADING_REVENUE = BUSINESS_TRADING_REVENUE; SHAREHOLDER_CAPITAL_EQUITY_CONTRIBUTION = SHAREHOLDER_CAPITAL_EQUITY_CONTRIBUTION; INTRA_GROUP_FINANCING_PARENT_FUNDING = INTRA_GROUP_FINANCING_PARENT_FUNDING; BANK_LOAN_CREDIT_FACILITY = BANK_LOAN_CREDIT_FACILITY; INVESTOR_FUNDRAISING_PROCEEDS = INVESTOR_FUNDRAISING_PROCEEDS; SALE_OF_ASSETS_BUSINESS = SALE_OF_ASSETS_BUSINESS; CRYPTO_ASSET_ACTIVITY_PROCEEDS = CRYPTO_ASSET_ACTIVITY_PROCEEDS; THIRD_PARTY_CLIENT_FUNDS = THIRD_PARTY_CLIENT_FUNDS; OTHER = Other.",
                        "maxLength": 1024,
                        "example": "OPERATING_REVENUE"
                      },
                      "purpose": {
                        "type": "string",
                        "description": "Purpose of the relationship. Free text is accepted, but sending one of these recognised codes keeps the structured value (any other text is stored as OTHER + details). Codes: OPERATIONAL_ACCOUNT = Operational account; SALARY = Salary; INVESTMENT = Investment; TREASURY_MANAGEMENT = Treasury management; ON_OFF_RAMP = On/Off-ramp (fiat <-> crypto); INTERNATIONAL_PAYMENTS = International payments / remittance; OTHER = Other.",
                        "maxLength": 1024,
                        "example": "BUSINESS_OPERATIONS"
                      },
                      "expectedYearlyTxCount": {
                        "type": "string",
                        "enum": [
                          "LT_50",
                          "B_50_500",
                          "B_500_5000",
                          "B_5000_50000",
                          "GT_50000"
                        ],
                        "description": "Expected yearly transaction count. Allowed values: LT_50 = < 50 transactions / year; B_50_500 = B_50_500; B_500_5000 = B_500_5000; B_5000_50000 = B_5000_50000; GT_50000 = GT_50000.",
                        "example": "B_50_200"
                      },
                      "geographicScope": {
                        "type": "array",
                        "description": "Countries that each account for >20% of expected flow value, with direction.",
                        "items": {
                          "type": "object",
                          "required": [
                            "countryCode",
                            "direction"
                          ],
                          "properties": {
                            "countryCode": {
                              "type": "string",
                              "minLength": 2,
                              "maxLength": 2,
                              "example": "FR"
                            },
                            "direction": {
                              "type": "string",
                              "enum": [
                                "SEND",
                                "RECEIVE",
                                "BOTH"
                              ],
                              "example": "BOTH"
                            }
                          }
                        }
                      },
                      "productsSubscribed": {
                        "type": "array",
                        "description": "Products the customer intends to use (\"select all that apply\").",
                        "items": {
                          "type": "string",
                          "enum": [
                            "DIRECT_MINT_BURN",
                            "EUR_ACCOUNT",
                            "FX_SWAP"
                          ],
                          "example": "EUR_ACCOUNT"
                        }
                      },
                      "financialAssets": {
                        "type": "string",
                        "description": "Total financial assets. Free text is accepted, but sending one of these recognised codes keeps the structured value (any other text is stored as OTHER + details). Codes: LT_100K = < €100,000; B_100K_1M = B_100K_1M; B_1M_10M = B_1M_10M; B_10M_100M = B_10M_100M; GT_100M = GT_100M.",
                        "maxLength": 255,
                        "example": "B_500K_2M"
                      },
                      "turnoverBracket": {
                        "type": "string",
                        "description": "Annual turnover. Free text is accepted, but sending one of these recognised codes keeps the structured value (any other text is stored as OTHER + details). Codes: LT_100K = < €100,000; B_100K_1M = B_100K_1M; B_1M_10M = B_1M_10M; B_10M_50M = €10,000,000 - €50,000,000; B_50M_250M = B_50M_250M; GT_250M = GT_250M.",
                        "maxLength": 255,
                        "example": "B_2M_10M"
                      },
                      "expectedYearlyVolume": {
                        "type": "string",
                        "enum": [
                          "LT_100K",
                          "B_100K_1M",
                          "B_1M_10M",
                          "B_10M_50M",
                          "B_50M_250M",
                          "GT_250M"
                        ],
                        "description": "Expected yearly transaction volume. Allowed values: LT_100K = < €100,000; B_100K_1M = B_100K_1M; B_1M_10M = B_1M_10M; B_10M_50M = €10,000,000 - €50,000,000; B_50M_250M = B_50M_250M; GT_250M = GT_250M.",
                        "example": "B_100K_1M"
                      },
                      "website": {
                        "type": "string",
                        "description": "Public website URL.",
                        "example": "https://dupont-fils.fr"
                      }
                    },
                    "description": "Company compliance profile: source of funds, purpose, expected activity, and financial profile."
                  },
                  "legalRepresentatives": {
                    "type": "array",
                    "description": "People who can legally represent the company.",
                    "items": {
                      "type": "object",
                      "required": [
                        "firstName",
                        "lastName",
                        "dateOfBirth",
                        "placeOfBirthCity",
                        "placeOfBirthCountryCode",
                        "nationalities",
                        "documentType",
                        "documentNumber",
                        "documentCountryCode",
                        "taxResidences",
                        "physicalAddress"
                      ],
                      "properties": {
                        "externalId": {
                          "type": "string",
                          "description": "Optional external ID assigned by Superclient",
                          "maxLength": 255,
                          "example": "CUST-67890"
                        },
                        "firstName": {
                          "type": "string",
                          "example": "Maxime"
                        },
                        "middleName": {
                          "type": "string",
                          "description": "Optional middle name.",
                          "maxLength": 255
                        },
                        "lastName": {
                          "type": "string",
                          "example": "Bernard"
                        },
                        "dateOfBirth": {
                          "type": "string",
                          "format": "date",
                          "example": "1990-01-15"
                        },
                        "placeOfBirthCity": {
                          "type": "string",
                          "maxLength": 100,
                          "example": "Paris"
                        },
                        "placeOfBirthCountryCode": {
                          "type": "string",
                          "minLength": 2,
                          "maxLength": 2,
                          "example": "FR"
                        },
                        "nationalities": {
                          "type": "array",
                          "description": "ISO 3166-1 alpha-2 codes; the first entry is the primary nationality.",
                          "minItems": 1,
                          "maxItems": 5,
                          "items": {
                            "type": "string",
                            "minLength": 2,
                            "maxLength": 2,
                            "example": "FR"
                          }
                        },
                        "residenceCountryCode": {
                          "type": "string",
                          "description": "Optional. Country of residence (ISO-2).",
                          "minLength": 2,
                          "maxLength": 2,
                          "example": "FR"
                        },
                        "email": {
                          "type": "string",
                          "format": "email",
                          "description": "Optional.",
                          "example": "maxime.bernard@dupont-fils.fr"
                        },
                        "phone": {
                          "type": "string",
                          "description": "Optional.",
                          "example": "+33612345678"
                        },
                        "documentType": {
                          "type": "string",
                          "enum": [
                            "ID",
                            "PASSPORT",
                            "RESIDENCY_PERMIT"
                          ],
                          "example": "PASSPORT"
                        },
                        "documentNumber": {
                          "type": "string",
                          "example": "26AF12345"
                        },
                        "documentCountryCode": {
                          "type": "string",
                          "description": "Document issuing country (ISO-2).",
                          "minLength": 2,
                          "maxLength": 2,
                          "example": "FR"
                        },
                        "documentExpiry": {
                          "type": "string",
                          "format": "date",
                          "description": "Optional. Document expiry date.",
                          "example": "2030-12-31"
                        },
                        "taxResidences": {
                          "type": "array",
                          "description": "Tax residences (1–5): each is a country + its taxpayer identification number.",
                          "minItems": 1,
                          "maxItems": 5,
                          "items": {
                            "type": "object",
                            "required": [
                              "countryCode",
                              "tin"
                            ],
                            "properties": {
                              "countryCode": {
                                "type": "string",
                                "minLength": 2,
                                "maxLength": 2,
                                "example": "FR"
                              },
                              "tin": {
                                "type": "string",
                                "maxLength": 255,
                                "example": "FR1234567890"
                              }
                            }
                          }
                        },
                        "kycVerificationLink": {
                          "type": "string",
                          "description": "Optional. Link to the KYC verification flow for this person.",
                          "maxLength": 1024,
                          "example": "https://kyc.example.com/verify/maxime-bernard"
                        },
                        "livenessLink": {
                          "type": "string",
                          "description": "Optional. Link to the liveness check flow for this person.",
                          "maxLength": 1024,
                          "example": "https://liveness.example.com/check/maxime-bernard"
                        },
                        "physicalAddress": {
                          "type": "object",
                          "required": [
                            "addressLine1",
                            "city",
                            "zipCode",
                            "countryCode"
                          ],
                          "properties": {
                            "addressLine1": {
                              "type": "string",
                              "example": "25 Avenue des Champs-Élysées"
                            },
                            "addressLine2": {
                              "type": "string",
                              "description": "Optional.",
                              "example": "Appt 5"
                            },
                            "city": {
                              "type": "string",
                              "example": "Paris"
                            },
                            "zipCode": {
                              "type": "string",
                              "example": "75001"
                            },
                            "countryCode": {
                              "type": "string",
                              "example": "FR",
                              "minLength": 2,
                              "maxLength": 2
                            }
                          }
                        }
                      }
                    }
                  },
                  "ubos": {
                    "type": "array",
                    "description": "Beneficial owners with 25% or more ownership. If none are above 25%, send an empty list or omit this field.",
                    "items": {
                      "type": "object",
                      "required": [
                        "ownerName",
                        "ownerType",
                        "ownershipPct"
                      ],
                      "properties": {
                        "ownerName": {
                          "type": "string",
                          "maxLength": 255,
                          "example": "Société Dupont Participations"
                        },
                        "ownerType": {
                          "type": "string",
                          "enum": [
                            "INDIVIDUAL",
                            "ENTITY"
                          ],
                          "example": "INDIVIDUAL"
                        },
                        "ownershipPct": {
                          "type": "number",
                          "minimum": 25,
                          "maximum": 100,
                          "example": 60
                        },
                        "ownershipResidenceCountryCode": {
                          "type": "string",
                          "minLength": 2,
                          "maxLength": 2,
                          "example": "FR"
                        },
                        "ownershipNationalities": {
                          "type": "array",
                          "minItems": 1,
                          "maxItems": 5,
                          "items": {
                            "type": "string",
                            "minLength": 2,
                            "maxLength": 2
                          },
                          "example": [
                            "FR"
                          ]
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Customer added successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CustomerDetailCompanyResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request - Invalid input data"
          },
          "401": {
            "description": "Unauthorized - Invalid or missing API key"
          }
        },
        "security": [
          {
            "api-key-config": []
          }
        ],
        "summary": "Add new Customer - legal entity type (B2B)",
        "tags": [
          "Customer"
        ]
      }
    }
  }
}